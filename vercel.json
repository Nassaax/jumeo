{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/demo-lux/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/demo-lux",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/devenir-partenaire",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/notre-histoire",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/simulateur-recharge",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/guides/photovoltaique-wallonie-ce-qui-a-change",
      "destination": "/guides",
      "permanent": true
    },
    {
      "source": "/guides/borne-de-recharge-maison",
      "destination": "/guides",
      "permanent": true
    },
    {
      "source": "/guides/renovation-par-ou-commencer",
      "destination": "/guides",
      "permanent": true
    },
    {
      "source": "/guides/pompe-a-chaleur-adaptee",
      "destination": "/guides",
      "permanent": true
    },
    {
      "source": "/guides/isolation-toiture",
      "destination": "/guides",
      "permanent": true
    },
    {
      "source": "/guides/bien-choisir-son-artisan",
      "destination": "/guides",
      "permanent": true
    }
  ]
}
